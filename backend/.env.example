# Environment variables for TradeX Backend
# Copy this to .env and fill in your values

# ── Supabase ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── JWT (for admin panel auth) ──
JWT_SECRET=generate-a-strong-random-uuid-here
JWT_EXPIRES_IN=24h

# ── Server ──
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
LANDING_URL=http://localhost:5175
AFFILIATE_PORTAL_URL=http://localhost:5176

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Market Data Feeds ──
# Finnhub (FREE — sign up at https://finnhub.io)
# Covers: Indian Stocks, US Stocks, Forex, Commodities, Indices
FINNHUB_API_KEY=your_finnhub_api_key_here

# Binance — NO KEY NEEDED (free public WebSocket for crypto)

# Shoonya (Finvasia) Feed API Configuration
# Required for real-time 0-lag Indian market data (Equities, Indices, F&O)
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_API_KEY=your_shoonya_api_key
SHOONYA_TOTP_SECRET=your_shoonya_totp_secret
SHOONYA_VENDOR_CODE=your_shoonya_vendor_code

# Fyers Real-Time Feed (Indian market — Equities, Indices, F&O, MCX)
# Required for 0-lag live market data. Get credentials at https://myaccount.fyers.in/
FYERS_USER_ID=your_fyers_user_id
FYERS_TOTP_SECRET=your_fyers_totp_secret_base32
FYERS_PIN=your_fyers_4_digit_pin
# Optional — only needed if you have a Fyers app (for full market depth)
FYERS_APP_ID=your_fyers_app_id
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_REDIRECT_URL=http://127.0.0.1

# ── Error Monitoring ──
SENTRY_DSN=your_sentry_dsn_url

# ── Redis ──
REDIS_URL=your_redis_url

# ── Email (Resend) ──
# Sign up free at https://resend.com and add your domain stockslab.live
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=StocksLab India <noreply@stockslab.live>
EMAIL_REPLY_TO=support@stockslab.live

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Generate with: openssl rand -hex 32
# Register with: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=generate-a-strong-random-hex-secret-here
TELEGRAM_TOPIC_SIGNUPS=

# ── Firebase (Push Notifications) ──
FIREBASE_WEB_API_KEY=your_firebase_web_api_key